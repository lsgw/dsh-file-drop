{
  "name": "dsh-file-drop",
  "version": "1.0.0",
  "description": "上传模式分块复制文件和目录到用户级 .dsh-drops；定位模式只获取或搜索原始路径",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs .",
    "verify:tarball": "node scripts/verify-tarball.mjs",
    "prepack": "npm test"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/shared",
    "src/host",
    "src/locate",
    "src/platform",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
